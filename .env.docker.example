# ---------------------------------------------------------------------------
# Docker Compose 生产环境模板
#
#   cp .env.docker.example .env
#   openssl rand -hex 24        # 生成 POSTGRES_PASSWORD
#   openssl rand -base64 32     # 生成 ENCRYPTION_KEY
#   docker compose up -d --build
#
# .env 已被 .gitignore 忽略,严禁提交。ENCRYPTION_KEY 丢失后,
# 数据库里已加密的厂商 API Key 将无法解密,请把它纳入备份。
# ---------------------------------------------------------------------------

# 对外端口。用 Nginx/Caddy 反代时建议 APP_BIND=127.0.0.1
APP_BIND=0.0.0.0
APP_PORT=3000

# PostgreSQL 容器口令(仅容器网络内使用)
POSTGRES_PASSWORD=

# 设置页厂商 API Key 的加密主密钥,必须为 32 字节(base64 或 64 位 hex)
ENCRYPTION_KEY=

# 模型服务全部在登录后的「设置 → 模型服务」里按账号绑定,不读取环境变量

# 文献数据源按账号配置:OpenAlex 使用注册邮箱,
# Semantic Scholar Key 登录后在设置页填写

# 每账号每日 token 预算
SAFETY_DAILY_TOKEN_BUDGET=400000

# 定时清理接口 Bearer 令牌(生产环境调用 /api/maintenance/cleanup 时必需)
MAINTENANCE_TOKEN=
