# ---------------------------------------------------------------------------
# StellarLit 环境变量模板
#
# 复制为 .env.local 后填写。.env.local 已被 .gitignore 忽略,严禁提交真实密钥。
# ---------------------------------------------------------------------------

# 大模型(OpenAI 兼容接口)。DeepSeek / 智谱 / 通义 / OpenAI 均可,只换 base url。
# 用于:关系判定、实体与关系抽取、RAG 生成、Agent 规划。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量模型(OpenAI 兼容 /embeddings)。用于语义距离与 RAG 检索召回。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 文献数据源。OpenAlex 与 arXiv 无需密钥,Semantic Scholar 有 key 可提高限额。
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# 本地数据目录(缓存与预计算产物),默认 ./data
# STELLARLIT_DATA_DIR=
