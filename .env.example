# ---------------------------------------------------------------------------
# StellarLit 环境变量模板
#
# 复制为 .env.local 后填写。.env.local 已被 .gitignore 忽略,严禁提交真实密钥。
# ---------------------------------------------------------------------------

# 环境变量模型配置。现在更推荐在 Web 设置页添加多厂商账户并绑定服务;
# 未绑定服务时仍会回退到这里。这里适合 OpenAI 兼容接口,Claude 请在设置页配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量模型(OpenAI 兼容 /embeddings)。优先在设置页「模型服务 → 向量检索」绑定;
# 下面三项仅作为部署级回退,普通使用不需要改这里。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# 敏感字段加密(AES-256-GCM)
#
# 设置页保存的厂商 API Key 会用这把主密钥加密后写入数据库。
# 生成新密钥:pnpm key:generate
# 生产环境必填;开发环境不填会退回明文并打印告警。
# 重要:丢失主密钥后,已加密的 API Key 无法恢复,请备份 .env.local。
ENCRYPTION_KEY=
# 轮换密钥时,把旧密钥填在这里(只用于解密旧数据),重新保存一次设置即可完成轮换。
# ENCRYPTION_KEY_PREVIOUS=

# 文献数据源。OpenAlex 与 arXiv 无需密钥,Semantic Scholar 有 key 可提高限额。
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# 本地数据目录(缓存与预计算产物),默认 ./data
# STELLARLIT_DATA_DIR=

# ---------------------------------------------------------------------------
# AI 安全护栏(可选)
#
# 每个账号每天的 token 预算(不是全站共享)。所有模型调用都会计量,
# 用尽后问答 / 建图 / 翻译返回 429,并在账号页与顶栏展示用量。
# SAFETY_DAILY_TOKEN_BUDGET=400000
#
# MCP 访问令牌在「设置 → MCP 工具」里按账号生成,不再使用全局环境变量。
# 仅 stdio 入口(`pnpm mcp`)需要把个人令牌放进环境变量:
# STELLARLIT_MCP_TOKEN=slmcp_xxx

# PostgreSQL 连接串。默认本机 stellarlit 库;首次启动自动建表并导入旧 JSON。
# 需要 PostgreSQL 16+,并先 createdb stellarlit。
# DATABASE_URL=postgresql://localhost:5432/stellarlit
# DATABASE_URL=postgresql://user:password@host:5432/stellarlit

# ---------------------------------------------------------------------------
# Redis 缓存(跨实例共享 / TTL 自动淘汰 / 上游 host 节流)
#
# 默认连本机;Redis 不可用时自动降级为「直接读源」,站点仍可用但会失去
# 跨实例节流与缓存命中。生产环境建议必配。
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=stellarlit

# 缓存策略(可选,括号内为默认值)
# CACHE_TTL_SEC=86400                 # 通用命名空间默认 TTL(1 天)
# STARFIELD_CACHE_TTL_SEC=600         # 整张星空 payload(10 分钟)
# STARFIELD_MAX_MB=8                  # 单张星空 JSON 体积上限
# DISK_CACHE_MAX_MB=256               # data/cache 容量上限
# DISK_CACHE_MAX_AGE_DAYS=30          # 磁盘缓存最长保留
# IMAGE_CACHE_MAX_ROWS=2000           # image_index_cache 最多保留行数
# IMAGE_CACHE_MAX_AGE_DAYS=30         # 图像分析结果最长空闲时间
# MAINTENANCE_INTERVAL_MIN=360        # 后台清理间隔(6 小时)

# 生产环境的清理接口密钥。不配置时生产环境会拒绝 /api/maintenance/cleanup;
# 开发环境可不配,直接 POST 调用。定时任务建议带 Authorization: Bearer <token>。
# MAINTENANCE_TOKEN=replace-with-random-token
